    "effect": "^3.21.0",
    "js-yaml@4": "^4.3.1",
    "fast-uri": "^3.1.5",
    "socket.io-parser": "^4.2.7",
    "ajv@8": "^8.18.0",
    "deepmerge-ts": "^8.0.0",
    "@babel/core": "^7.29.7"
  },
