{
  "name": "session-management-server",
  "version": "0.3.0",
  "description": "",
  "author": "Universität St. Gallen (HSG) & University of Zurich (UZH)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prestart": "bash scripts/check-livekit.sh && npx prisma generate && npx prisma migrate deploy",
    "prestart:dev": "bash scripts/check-livekit.sh && npx prisma generate && npx prisma migrate deploy",
    "prestart:prod": "npx prisma generate && npx prisma migrate deploy",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "validate:agents": "ts-node scripts/validate-agents.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "fix-room-urls": "ts-node scripts/fix-room-urls.ts",
    "bootstrap:admin": "ts-node scripts/bootstrap-initial-admin.ts",
    "db:seed": "npx tsc prisma/seed.ts --outDir prisma --esModuleInterop --resolveJsonModule --module nodenext --moduleResolution nodenext --target ES2023 --skipLibCheck && node prisma/seed.js",
    "db:seed:run": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "js-yaml@3": "^3.15.1",
    "picomatch@2": "^2.3.2",
