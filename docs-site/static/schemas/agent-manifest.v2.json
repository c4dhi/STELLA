{
  "$id": "https://stella.c4dhi.org/schemas/agent-manifest.v2.json",
  "title": "STELLA agent manifest (agent.yaml)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            }
          },
          "required": [
            "name"
          ]
        },
        "icon": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "deprecationNote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "slug",
        "version",
        "description"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "voice",
          "text",
          "progress",
          "plans",
          "experts",
          "companion"
        ]
      }
    },
    "features": {
      "default": {
        "persona": true,
        "configurator": false
      },
      "type": "object",
      "properties": {
        "persona": {
          "default": true,
          "type": "boolean"
        },
        "plans": {
          "type": "object",
          "properties": {
            "required": {
              "default": false,
              "type": "boolean"
            },
            "modes": {
              "default": [
                "plan"
              ],
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "plan",
                  "companion"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "configurator": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "env": {
      "default": {
        "required": [],
        "optional": []
      },
      "type": "object",
      "properties": {
        "required": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "optional": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "description": {
                "type": "string"
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "connectors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mcp"
            ]
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "requiredTools": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "slot",
          "kind",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "dockerfile": {
          "type": "string",
          "minLength": 1
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "memory": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "pattern": "^\\d+(Ki|Mi|Gi)?$"
            },
            "limit": {
              "type": "string",
              "pattern": "^\\d+(Ki|Mi|Gi)?$"
            }
          },
          "additionalProperties": false
        },
        "cpu": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "pattern": "^\\d+m?$"
            },
            "limit": {
              "type": "string",
              "pattern": "^\\d+m?$"
            }
          },
          "additionalProperties": false
        },
        "gpu": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/__schema0"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "defaultConfig": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "pipelineSchema": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "position": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "number"
                  },
                  "col": {
                    "type": "number"
                  }
                },
                "required": [
                  "row",
                  "col"
                ]
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "number",
                        "select",
                        "string_list",
                        "key_value",
                        "expert_list",
                        "verdict_directives"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "default": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number"
                    },
                    "maxLength": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "isCustom": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "type"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "id",
              "label",
              "position",
              "slots"
            ],
            "additionalProperties": {}
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "style": {
                "type": "string",
                "enum": [
                  "solid",
                  "dashed"
                ]
              }
            },
            "required": [
              "source",
              "target"
            ],
            "additionalProperties": {}
          }
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "default": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "label",
              "type"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "nodes",
        "edges",
        "thresholds"
      ]
    },
    "runtimeVariables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "parametric": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": {}
      }
    },
    "promptCompiler": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "sdk": {
      "type": "object",
      "properties": {
        "minVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "metadata",
    "image"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
